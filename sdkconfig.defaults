# ESP-IDF Configuration Defaults for BGA Reflow Controller (ESP32-S3 N16R8)

# Target Board Hardware Settings
CONFIG_IDF_TARGET="esp32s3"

# Flash Size (16 MB Quad/Octal SPI Flash)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# PSRAM (8 MB Octal PSRAM for N16R8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Allocations < 65536 bytes go to internal SRAM.
# This ensures DMA-capable buffers (SPI, etc.) never land in PSRAM.
# spi_device_polling_transmit() requires buffers in internal SRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=65536

# Cache Line Size for Octal DDR PSRAM (ESP32-S3 N16R8)
# MUST be 64 bytes for Octal DDR (OPI) PSRAM mode.
# Wrong size (32 bytes default) causes silent data corruption on PSRAM evictions.
CONFIG_ESP32S3_DATA_CACHE_LINE_SIZE_64B=y

# SPI Master Driver in IRAM (ESP32-S3 + Octal PSRAM — Critical)
# spi_device_polling_transmit() busy-waits in a tight loop.
# If that loop resides in Flash cache and a cache miss occurs while the PSRAM
# bus is active (e.g., DMA to PSRAM from another peripheral), the CPU stalls
# mid-transaction → "Access cache when cache is disabled" panic.
# Moving the SPI master ISR and polling routines to IRAM prevents this.
CONFIG_SPI_MASTER_IN_IRAM=y

# Partition Table (Custom 16MB table for OTA + 3.375MB LittleFS)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="default_16MB_partitions.csv"

# C++ Standard & Exception Support
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y

# FreeRTOS 1000 Hz Tick Rate (1 ms precision) & Stack Protection
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_PTRVAL=y
# CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y ?

# HTTP Server & WebSockets Support
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# LwIP Sockets & TCP Optimization for Concurrency
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_MAX_ACTIVE_TCP=24
CONFIG_LWIP_MAX_LISTENING_TCP=16
CONFIG_LWIP_TCP_MSL=5000
CONFIG_LWIP_TCP_FIN_WAIT_TIMEOUT=5000
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_LINGER=y

# Serial Console
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Automated Unit Tests on Boot (Development default: y)
CONFIG_REFLOW_ENABLE_UNIT_TESTS=y
CONFIG_REFLOW_HALT_ON_TEST_FAILURE=y

# Core Dump to Flash (Post-Mortem Diagnostics)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Task Watchdog Timer (TWDT - 5s Timeout)
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
